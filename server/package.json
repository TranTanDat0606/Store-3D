{
  "name": "store3d-server",
  "version": "1.0.0",
  "description": "Store 3D - E-commerce backend for 3D printed models",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test tests/vietQr.test.ts tests/payment.test.ts",
    "seed": "tsx src/services/seed.ts",
    "seed:prod": "node dist/services/seed.js"
  },
  "keywords": [
    "ecommerce",
    "3d-print",
    "store3d"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "multer": "^2.2.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.3.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
