# Server environment variables
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/store3d

# JWT secrets
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Bank transfer (VietQR) configuration
BANK_BIN=970423
BANK_ACCOUNT_NUMBER=70877769859
BANK_ACCOUNT_NAME=TRAN TAN DAT
BANK_ACCOUNT_DISPLAY_NAME=Trần Tấn Đạt
QR_TTL_MINUTES=5
PAYMENT_WEBHOOK_SECRET=
