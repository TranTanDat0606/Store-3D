# Server environment variables
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/store3d

# JWT secrets
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Bank transfer (VietQR) configuration
BANK_BIN=970423
BANK_ACCOUNT_NUMBER=70877769859
BANK_ACCOUNT_NAME=TRAN TAN DAT
BANK_ACCOUNT_DISPLAY_NAME=Trần Tấn Đạt
QR_TTL_MINUTES=5
PAYMENT_WEBHOOK_SECRET=

# Cloudinary (image upload) — get from https://cloudinary.com Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP / Email (for contact form)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SUPPORT_EMAIL=support@store3d.com

# AI Chat (optional - mock provider used if not set)
AI_PROVIDER=mock
AI_MODEL=gpt-3.5-turbo
AI_API_KEY=your_api_key_here
